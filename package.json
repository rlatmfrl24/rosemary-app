{
	"name": "rosemary-app",
	"version": "8.4.5",
	"description": "An Electron application with React and TypeScript",
	"main": "./out/main/index.js",
	"author": "example.com",
	"homepage": "https://electron-vite.org",
	"scripts": {
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
		"typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
		"typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
		"test": "node scripts/test.mjs",
		"test:coverage": "node scripts/test.mjs --coverage",
		"test:metadata": "node --experimental-strip-types --test tests/gallery-metadata.test.mjs tests/organization-metadata.test.mjs tests/archive-metadata-recovery.test.mjs tests/crawler-database.test.mjs tests/crawler-download-dispatch.test.mjs tests/crawler-metadata-integration.test.mjs tests/crawler-request-policy.test.mjs tests/hitomi-catalog-index.test.mjs tests/tag-preferences.test.mjs",
		"test:startup": "node --experimental-strip-types --test tests/runtime-paths.test.mjs tests/downloader-startup.test.mjs",
		"test:hitomi-api": "node --experimental-strip-types --test tests/hitomi-api-script.test.mjs",
		"smoke:start": "pnpm run build && node scripts/smoke-electron-start.mjs",
		"start": "electron-vite preview",
		"dev": "electron-vite dev",
		"build": "pnpm run typecheck && electron-vite build",
		"rebuild:native": "electron-builder install-app-deps",
		"build:unpack": "pnpm run build && electron-builder --dir",
		"build:win": "pnpm run build && electron-builder --win",
		"build:win:setup": "pnpm run build:win && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-latest-windows-setup.ps1",
		"build:mac": "electron-vite build && electron-builder --mac",
		"build:linux": "electron-vite build && electron-builder --linux"
	},
	"dependencies": {
		"@electron-toolkit/utils": "^4.0.0",
		"cheerio": "^1.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@electron-toolkit/tsconfig": "^2.0.0",
		"@types/node": "^26.6.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"electron": "^44.5.1",
		"electron-builder": "^26.15.3",
		"electron-vite": "^5.0.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"tailwindcss": "^4.3.3",
		"daisyui": "^5.7.47"
	}
}
